name: Test PR Age (2 min)
on:
  workflow_dispatch: 
  schedule:
    - cron: '0 * * * *'

permissions:
  pull-requests: write
  contents: read

jobs:
  check-and-comment:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check PRs and Comment
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Ahora 'gh' detectará automáticamente el repositorio gracias al checkout
          prs=$(gh pr list --state open --json number,createdAt)
          now=$(date +%s)
          
          echo "Ejecutando comprobación a las: $(date)"
          
          echo "$prs" | jq -c '.[]' | while read -r pr; do
            number=$(echo $pr | jq -r '.number')
            created_at=$(echo $pr | jq -r '.createdAt')
            created_ts=$(date -d "$created_at" +%s)
            
            diff=$(( (now - created_ts) / 3600 ))
            
            echo "PR #$number: $diff horas abierta."
            
            if [ $diff -ge 6 ]; then
              echo "Enviando comentario a la PR #$number..."
              gh pr comment $number --body "⚠️ **Aviso:** Esta PR lleva abierta más de 6 horas."
            fi
          done
